{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outpost-web",
  "pages_build_output_dir": "./site",
  "compatibility_date": "2026-08-22",
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "outpost-download-analytics",
      "database_id": "0ebb8c01-8411-464c-9ab9-bd6945c9148b"
    },
    {
      "binding": "CMS_DB",
      "database_name": "outpost-cms-production",
      "database_id": "59db204d-7252-4b84-ba29-3bb8c8438129"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "ANALYTICS_DB",
          "database_name": "outpost-download-analytics-staging",
          "database_id": "1db69075-97d9-43fd-92df-12f7a330ed21"
        },
        {
          "binding": "CMS_DB",
          "database_name": "outpost-cms-staging",
          "database_id": "48e1bd8c-16f9-4631-a4e2-7ed62fca00d0"
        }
      ]
    }
  }
}
