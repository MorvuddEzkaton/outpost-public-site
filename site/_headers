/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https://cabinet.outpost.com.ua 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Online demo changes frequently while it is being brought closer to the desktop app.
# Revalidate these browser-local assets so a previous demo build cannot mask new keyboard/UI fixes.
/assets/outpost-demo-v1.css
  Cache-Control: no-cache, max-age=0, must-revalidate

/assets/outpost-demo-v1.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/assets/outpost-demo-modules-v1.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/assets/outpost-demo-returns-v1.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/assets/outpost-demo-products-v1.js
  Cache-Control: no-cache, max-age=0, must-revalidate
