* text=auto eol=lf

*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf
# Preserve the exact Windows-produced checksum bytes (including CRLF) in Git worktrees.
# The immutable release registry hashes these original file bytes, not normalized text.
site/downloads/*.sha256.txt -text

*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.exe binary
*.zip binary
